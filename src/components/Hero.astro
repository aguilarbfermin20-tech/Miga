---
import { Picture } from 'astro:assets';
import heroImg from '../assets/img/hero.jpg';

// Titular dividido en letras en el servidor: sin parpadeo ni salto de layout.
// Las palabras van en un .w sin cortes para que el texto siga partiendo
// entre palabras en pantallas chicas.
const lines = [
  { text: 'Pan de verdad,', gold: false },
  { text: 'a las 7.', gold: true },
];
const label = lines.map((l) => l.text).join(' ');
---

<script is:inline>
  // Oculta las letras antes del primer pintado solo si va a haber entrada animada
  if (matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches)
    document.documentElement.classList.add('hero-intro');

  // La palabra gigante de fondo espera a Fraunces: así no salta de ancho al cambiar
  // de fuente (CLS) ni se pinta dos veces a 560 px.
  (function () {
    var root = document.documentElement;
    if (!document.fonts || !document.fonts.load) return;
    root.classList.add('word-wait');
    var show = function () {
      var go = function () { root.classList.remove('word-wait'); };
      if (window.requestIdleCallback) requestIdleCallback(go, { timeout: 1000 });
      else setTimeout(go, 0);
    };
    document.fonts.load('800 100px "Fraunces Variable"', 'miga').then(show, show);
    setTimeout(show, 3000);
  })();
</script>
<header class="hero grain" id="hero" data-hero>
  <div class="layer l-photo" data-depth="18" data-scroll-speed=".25" aria-hidden="true">
    <Picture
      src={heroImg}
      formats={['avif', 'webp']}
      widths={[640, 828, 1080, 1440, 1800]}
      quality={35}
      sizes="112vw"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="layer l-word" data-depth="-28" data-scroll-speed="-.12" aria-hidden="true">
    <span>miga</span>
  </div>
  <div class="layer l-shade" aria-hidden="true"></div>
  <div class="seal" data-depth="40" aria-hidden="true">
    <svg viewBox="0 0 200 200" focusable="false">
      <defs>
        <path id="seal-circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path>
      </defs>
      <text><textPath href="#seal-circle" textLength="488" lengthAdjust="spacing">MASA MADRE · 36 HORAS · HORNO DE PISO · </textPath></text>
    </svg>
    <b>36h</b>
  </div>

  <div class="wrap content">
    <h1 class="headline" aria-label={label} data-headline>
      {
        lines.map((line) => (
          <span class:list={['line', { gold: line.gold }]} aria-hidden="true">
            {line.text.split(' ').map((word, i, words) => (
              <>
                <span class="w">
                  {[...word].map((c) => (
                    <span class="ch">{c}</span>
                  ))}
                </span>
                {i < words.length - 1 && ' '}
              </>
            ))}
          </span>
        ))
      }
    </h1>
    <div class="side">
      <p>Masa madre, harina de molino chico, agua, sal y tiempo. Horneamos todos los días en Villa Crespo.</p>
      <div class="ctas">
        <a class="btn btn-yolk" href="#hoy">Armar mi pedido</a>
        <a class="btn btn-line" href="#proceso">Cómo lo hacemos</a>
      </div>
    </div>
  </div>

  <div class="scroll-hint mono" aria-hidden="true">Bajá<i></i></div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 680px;
    overflow: hidden;
    isolation: isolate;
    background: var(--ink);
    color: var(--paper);
  }

  .layer { position: absolute; inset: 0; }
  .l-photo { inset: -6%; }
  .l-photo :global(picture) { display: block; width: 100%; height: 100%; }
  .l-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }

  :global(.word-wait) .l-word { visibility: hidden; }
  .l-word {
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .l-word span {
    font-family: var(--serif);
    font-size: min(38vw, 560px);
    font-weight: 800;
    font-variation-settings: var(--fvs);
    line-height: .8;
    letter-spacing: -.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(242, 179, 27, .45);
    user-select: none;
  }

  .l-shade {
    background:
      linear-gradient(180deg, rgba(26, 21, 18, .65), rgba(26, 21, 18, .25) 40%, rgba(26, 21, 18, .92)),
      linear-gradient(90deg, rgba(26, 21, 18, .5), transparent 60%);
  }

  /* Las capas que se mueven con puntero/scroll solo reservan GPU cuando hay efecto */
  :global(.has-parallax) .l-photo,
  :global(.has-parallax) .l-word,
  :global(.has-parallax) .seal { will-change: transform, translate; }

  .seal {
    position: absolute;
    z-index: 4;
    top: 120px;
    right: max(24px, env(safe-area-inset-right, 0px));
    width: 140px;
    height: 140px;
  }
  .seal svg {
    width: 100%;
    height: 100%;
    animation: turn 22s linear infinite;
  }
  .seal text {
    fill: var(--paper);
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 500;
  }
  .seal b {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--serif);
    font-size: 40px;
    font-weight: 600;
    font-variation-settings: "SOFT" 100;
    color: var(--yolk);
  }
  @keyframes turn { to { transform: rotate(360deg); } }

  .content {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 40px;
    min-height: 680px;
    padding-block: 160px 64px;
  }

  .headline {
    font-size: var(--fs-h1);
    cursor: default;
  }
  .headline .line { display: block; }
  .headline .w { display: inline-block; white-space: nowrap; }
  .headline .ch {
    display: inline-block;
    font-weight: 300;
    transition: font-weight .25s ease-out;
  }
  .headline .gold { color: var(--yolk); font-style: italic; }
  :global(.hero-intro) .headline .ch { opacity: 0; }

  .side {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 340px;
  }
  .side p { font-size: 18px; color: var(--on-ink); }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; }

  .scroll-hint {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: var(--on-ink-soft);
    transform: translateX(-50%);
  }
  .scroll-hint i {
    width: 1.5px;
    height: 34px;
    background: linear-gradient(var(--yolk), transparent);
    animation: drip 1.8s ease-in-out infinite;
  }
  @keyframes drip {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  @media (max-width: 860px) {
    .hero, .content { min-height: 620px; }
    .content { grid-template-columns: 1fr; gap: 28px; padding-block: 150px 72px; }
    .scroll-hint { display: none; }
    .seal { top: 92px; width: 104px; height: 104px; }
    .seal b { font-size: 30px; }
  }
</style>

<script>
  import { allowsFancyMotion, onResize, onScroll } from '../lib/motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const chars = [...hero.querySelectorAll<HTMLElement>('.headline .ch')];
  const depthLayers = [...hero.querySelectorAll<HTMLElement>('[data-depth]')].map((el) => ({
    el,
    depth: Number(el.dataset.depth),
  }));
  const scrollLayers = [...hero.querySelectorAll<HTMLElement>('[data-scroll-speed]')].map((el) => ({
    el,
    speed: Number(el.dataset.scrollSpeed),
  }));

  const RADIUS = 260;
  const REST = 300;
  const MAX = 900;

  /* ---------- Entrada escalonada del titular ---------- */
  const root = document.documentElement;
  if (root.classList.contains('hero-intro')) {
    chars.forEach((ch, i) => {
      ch.animate(
        [
          { transform: 'translateY(60%)', opacity: 0 },
          { transform: 'none', opacity: 1 },
        ],
        { duration: 700, delay: 200 + i * 28, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'backwards' },
      );
    });
    // fill: backwards mantiene el estado inicial durante el retraso, así que ya podemos soltar la clase
    root.classList.remove('hero-intro');
  }

  /* ---------- Posiciones cacheadas de las letras (coordenadas de página) ---------- */
  let centers: { x: number; y: number }[] = [];
  function measure() {
    const sx = window.scrollX;
    const sy = window.scrollY;
    centers = chars.map((ch) => {
      const r = ch.getBoundingClientRect();
      return { x: r.left + r.width / 2 + sx, y: r.top + r.height / 2 + sy };
    });
  }
  measure();
  onResize(measure);
  document.fonts?.ready.then(measure);

  /* ---------- Puntero: peso variable + capas ---------- */
  let px = 0;
  let py = 0;
  let pending = false;
  let active = false;

  function applyPointer() {
    pending = false;
    if (!active) return;
    const sx = window.scrollX;
    const sy = window.scrollY;
    for (let i = 0; i < chars.length; i++) {
      const c = centers[i];
      const d = Math.hypot(px + sx - c.x, py + sy - c.y);
      const w = Math.round(REST + (MAX - REST) * Math.max(0, 1 - d / RADIUS));
      chars[i].style.fontWeight = String(w);
    }
    const nx = px / window.innerWidth - 0.5;
    const ny = py / window.innerHeight - 0.5;
    for (const { el, depth } of depthLayers) el.style.translate = `${nx * depth}px ${ny * depth}px`;
  }

  hero.addEventListener(
    'pointermove',
    (e) => {
      if (e.pointerType !== 'mouse' || !allowsFancyMotion()) return;
      active = true;
      px = e.clientX;
      py = e.clientY;
      if (!pending) {
        pending = true;
        requestAnimationFrame(applyPointer);
      }
    },
    { passive: true },
  );

  hero.addEventListener('pointerleave', () => {
    active = false;
    chars.forEach((ch) => (ch.style.fontWeight = ''));
  });

  /* ---------- Scroll: parallax de foto y palabra ---------- */
  let parallaxOn = false;
  onScroll((y) => {
    if (!allowsFancyMotion()) {
      if (parallaxOn) {
        scrollLayers.forEach(({ el }) => (el.style.transform = ''));
        depthLayers.forEach(({ el }) => (el.style.translate = ''));
        root.classList.remove('has-parallax');
        parallaxOn = false;
      }
      return;
    }
    if (!parallaxOn) {
      root.classList.add('has-parallax');
      parallaxOn = true;
    }
    if (y > hero.offsetHeight) return; // fuera de vista: no hace falta mover nada
    for (const { el, speed } of scrollLayers) el.style.transform = `translateY(${y * speed}px)`;
  });
</script>
