---
import horarios from '../data/horarios.json';

const opciones = ['Hoy antes de las 20 h', 'Mañana a la mañana', 'Mañana a la tarde'];
---

<div class="order" data-order-root>
  <button class="btn fab" type="button" data-open-order data-fab aria-haspopup="dialog" aria-controls="pedido">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4.5 19.5 5.6 16A8 8 0 1 1 8.4 18.6Z" />
      <path d="M9.2 8.6c.3 2.7 2.4 5 5.2 5.6l1-1.2-1.8-1-1 .6c-.9-.4-1.6-1.2-2-2l.6-1-1-1.8Z" />
    </svg>
    Ver pedido · <span data-fab-total>$ 0</span>
  </button>

  <div class="toast" role="status" aria-live="polite" data-toast></div>

  <div class="scrim" data-scrim></div>

  <div class="drawer" id="pedido" role="dialog" aria-modal="true" aria-labelledby="pedido-title" data-drawer>
    <div class="drawer-head">
      <h2 id="pedido-title" tabindex="-1">Tu pedido</h2>
      <button class="x" type="button" aria-label="Cerrar pedido" data-close>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>

    <div class="lines" data-lines>
      <p class="empty">Todavía no sumaste nada. Elegí del horno de hoy.</p>
    </div>

    <p class="total">
      <span>Total</span><span data-total>$ 0</span>
    </p>
    <p class="visually-hidden" aria-live="polite" data-order-status></p>

    <label class="pickup">
      ¿Cuándo pasás a buscarlo?
      <select data-pickup>
        {opciones.map((o) => <option>{o}</option>)}
      </select>
    </label>

    <button class="btn btn-yolk send" type="button" data-send disabled>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4.5 19.5 5.6 16A8 8 0 1 1 8.4 18.6Z" />
        <path d="M9.2 8.6c.3 2.7 2.4 5 5.2 5.6l1-1.2-1.8-1-1 .6c-.9-.4-1.6-1.2-2-2l.6-1-1-1.8Z" />
      </svg>
      Enviar pedido por WhatsApp
    </button>
    <p class="fine">
      Se abre WhatsApp con el pedido escrito. Si no se abre, escribinos al {horarios.whatsappVisible}.
    </p>
  </div>
</div>

<style>
  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Botón flotante */
  .fab {
    position: fixed;
    z-index: 25;
    right: calc(18px + env(safe-area-inset-right, 0px));
    bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    background: var(--wa);
    color: #fff;
    box-shadow: var(--shadow-fab);
    transform: translateY(160%);
    visibility: hidden;
    transition: transform var(--t-drawer) var(--ease), visibility 0s linear var(--t-drawer);
  }
  .fab.is-shown {
    transform: none;
    visibility: visible;
    transition: transform var(--t-drawer) var(--ease), visibility 0s;
  }
  .fab.is-shown:hover { transform: translateY(-2px); }

  /* Aviso */
  .toast {
    position: fixed;
    z-index: 26;
    left: 50%;
    bottom: calc(88px + env(safe-area-inset-bottom, 0px));
    max-width: calc(100vw - 32px);
    padding: 10px 18px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--paper);
    font-size: 14px;
    opacity: 0;
    transform: translate(-50%, 20px);
    pointer-events: none;
    transition: opacity .3s, transform .3s var(--ease);
  }
  .toast.is-shown { opacity: 1; transform: translate(-50%, 0); }
  .toast:empty { padding: 0; }

  /* Fondo */
  .scrim {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgba(26, 21, 18, .45);
    opacity: 0;
    pointer-events: none;
    transition: opacity .3s;
  }
  .scrim.is-open { opacity: 1; pointer-events: auto; }

  /* Cajón */
  .drawer {
    position: fixed;
    z-index: 60;
    inset: 0 0 0 auto;
    display: flex;
    flex-direction: column;
    width: min(420px, 100%);
    padding:
      calc(20px + env(safe-area-inset-top, 0px))
      calc(20px + env(safe-area-inset-right, 0px))
      calc(20px + env(safe-area-inset-bottom, 0px))
      20px;
    background: var(--paper);
    box-shadow: var(--shadow-drawer);
    transform: translateX(105%);
    visibility: hidden;
    transition: transform var(--t-drawer) var(--ease), visibility 0s linear var(--t-drawer);
  }
  .drawer.is-open {
    transform: none;
    visibility: visible;
    transition: transform var(--t-drawer) var(--ease), visibility 0s;
  }

  .drawer-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .drawer h2 { font-size: 44px; }
  .drawer h2:focus { outline: none; }

  .x {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--crumb);
  }
  .x svg { width: 20px; height: 20px; }

  .lines {
    flex: 1;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
  }
  .empty { padding-block: 24px; color: var(--muted); }

  .lines :global(.line) {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 12px;
    padding-block: 10px;
    border-bottom: 1px solid var(--crumb);
  }
  .lines :global(.line-name) { font-weight: 600; line-height: 1.3; }
  .lines :global(.qty) { display: flex; align-items: center; gap: 4px; }
  .lines :global(.qty button) {
    position: relative;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin: 6px;
    padding: 0;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: transparent;
    transition: background-color .2s, color .2s;
  }
  /* Área táctil de 44 px aunque el círculo mida 32 */
  .lines :global(.qty button)::after { content: ""; position: absolute; inset: -6px; }
  .lines :global(.qty button:hover) { background: var(--ink); color: var(--paper); }
  .lines :global(.qty svg) { width: 16px; height: 16px; }
  .lines :global(.qty output) {
    min-width: 20px;
    font-family: var(--mono);
    font-weight: 700;
    text-align: center;
  }
  .lines :global(.sub) {
    min-width: 84px;
    font-family: var(--mono);
    font-size: 14px;
    text-align: right;
  }

  .total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 16px;
    font-family: var(--mono);
    font-size: 18px;
    font-weight: 700;
  }

  .pickup {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 14px;
    font-size: 14px;
    font-weight: 600;
  }
  .pickup select {
    min-height: 46px;
    padding: 0 12px;
    border: 1.5px solid var(--muted);
    border-radius: 12px;
    background: #fff;
    font-weight: 500;
  }

  .send { width: 100%; }
  .send:disabled { background: var(--crumb); color: var(--muted); }

  .fine { margin-top: 10px; font-size: 13px; color: var(--muted); }
</style>

<script>
  import { subscribe, add, change, totals, whatsappUrl, producto, cantidad } from '../lib/cart';
  import { money } from '../lib/format';

  type Pedido = Readonly<Record<string, number>>;
  const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel)!;

  const root = $<HTMLElement>('[data-order-root]');
  const drawer = $<HTMLElement>('[data-drawer]');
  const scrim = $<HTMLElement>('[data-scrim]');
  const lines = $<HTMLElement>('[data-lines]');
  const totalEl = $<HTMLElement>('[data-total]');
  const statusEl = $<HTMLElement>('[data-order-status]');
  const pickup = $<HTMLSelectElement>('[data-pickup]');
  const send = $<HTMLButtonElement>('[data-send]');
  const closeBtn = $<HTMLButtonElement>('[data-close]');
  const title = $<HTMLElement>('#pedido-title');
  const fab = $<HTMLButtonElement>('[data-fab]');
  const fabTotal = $<HTMLElement>('[data-fab-total]');
  const toastEl = $<HTMLElement>('[data-toast]');
  const countEl = $<HTMLElement>('[data-count]');
  const countSr = $<HTMLElement>('[data-count-sr]');
  const navBag = $<HTMLButtonElement>('.bag-btn');

  const SVG_NS = 'http://www.w3.org/2000/svg';
  function icon(d: string) {
    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('aria-hidden', 'true');
    svg.setAttribute('focusable', 'false');
    const path = document.createElementNS(SVG_NS, 'path');
    path.setAttribute('d', d);
    svg.append(path);
    return svg;
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    if (text != null) node.textContent = text;
    return node;
  }

  const plural = (n: number) => `${n} ${n === 1 ? 'producto' : 'productos'}`;

  function qtyButton(id: string, nombre: string, delta: 1 | -1) {
    const b = el('button');
    b.type = 'button';
    b.dataset.k = id;
    b.dataset.d = String(delta);
    b.setAttribute('aria-label', `${delta < 0 ? 'Quitar' : 'Sumar'} uno de ${nombre}`);
    b.append(icon(delta < 0 ? 'M6 12h12' : 'M12 6v12M6 12h12'));
    return b;
  }

  /* ---------- Render ---------- */
  let prevUnidades = -1;

  function renderLines(p: Pedido) {
    // Recordar qué botón tenía el foco para devolvérselo después de redibujar
    const active = document.activeElement as HTMLElement | null;
    const focusK = active && lines.contains(active) ? active.dataset.k : undefined;
    const focusD = active?.dataset.d;
    const prevIds = [...lines.querySelectorAll<HTMLElement>('.line')].map((l) => l.dataset.k!);

    lines.replaceChildren();
    const ids = Object.keys(p);
    if (!ids.length) lines.append(el('p', 'empty', 'Todavía no sumaste nada. Elegí del horno de hoy.'));

    for (const id of ids) {
      const prod = producto(id);
      if (!prod) continue;
      const line = el('div', 'line');
      line.dataset.k = id;
      const qty = el('span', 'qty');
      const out = el('output', undefined, String(p[id]));
      out.setAttribute('aria-label', `${p[id]} de ${prod.nombre}`);
      qty.append(qtyButton(id, prod.nombre, -1), out, qtyButton(id, prod.nombre, 1));
      line.append(el('span', 'line-name', prod.nombre), qty, el('span', 'sub', money(prod.precio * p[id])));
      lines.append(line);
    }

    if (!focusK) return;
    const same = lines.querySelector<HTMLElement>(`button[data-k="${focusK}"][data-d="${focusD}"]`);
    if (same) {
      same.focus();
      return;
    }
    // La línea desapareció: foco a la que quedó en su lugar, o al título
    const lineas = lines.querySelectorAll<HTMLElement>('.line');
    const vecina = lineas[Math.min(prevIds.indexOf(focusK), lineas.length - 1)];
    (vecina?.querySelector<HTMLElement>('button') ?? title).focus();
  }

  function render(p: Pedido) {
    const { unidades, total } = totals();
    renderLines(p);

    totalEl.textContent = money(total);
    fabTotal.textContent = money(total);
    send.disabled = unidades === 0;
    statusEl.textContent = unidades
      ? `${plural(unidades)} en tu pedido. Total ${money(total)}.`
      : 'Tu pedido está vacío.';

    countEl.textContent = String(unidades);
    countSr.textContent = unidades ? `(${plural(unidades)})` : '(vacío)';
    if (prevUnidades >= 0 && unidades > prevUnidades) {
      countEl.classList.remove('is-bump');
      void countEl.offsetWidth;
      countEl.classList.add('is-bump');
    }
    prevUnidades = unidades;

    const fabHadFocus = document.activeElement === fab;
    fab.classList.toggle('is-shown', unidades > 0);
    if (fabHadFocus && !unidades) navBag.focus();

    document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((b) => {
      const n = cantidad(b.dataset.add!);
      b.classList.toggle('is-added', n > 0);
      const label = b.querySelector('[data-add-label]');
      if (label) label.textContent = n ? `✓ En tu pedido (${n})` : '+ Sumar al pedido';
    });
  }

  countEl.addEventListener('transitionend', () => countEl.classList.remove('is-bump'));

  /* ---------- Aviso ---------- */
  let toastTimer = 0;
  function toast(msg: string) {
    toastEl.textContent = msg;
    toastEl.classList.add('is-shown');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toastEl.classList.remove('is-shown'), 1800);
  }

  /* ---------- Cajón ---------- */
  let lastFocus: HTMLElement | null = null;
  let isOpen = false;

  function setBackgroundInert(on: boolean) {
    for (const child of document.body.children) {
      if (child !== root) (child as HTMLElement).inert = on;
    }
    fab.inert = on;
  }

  function openOrder(trigger: HTMLElement | null) {
    if (isOpen) return;
    isOpen = true;
    lastFocus = trigger;
    drawer.classList.add('is-open');
    scrim.classList.add('is-open');
    document.documentElement.classList.add('is-locked');
    setBackgroundInert(true);
    closeBtn.focus();
  }

  function closeOrder() {
    if (!isOpen) return;
    isOpen = false;
    drawer.classList.remove('is-open');
    scrim.classList.remove('is-open');
    document.documentElement.classList.remove('is-locked');
    setBackgroundInert(false);
    // Si quien abrió ya no está visible (p. ej. el botón flotante con el pedido vacío), vuelve al nav
    const visible = lastFocus?.isConnected && !(lastFocus === fab && !fab.classList.contains('is-shown'));
    (visible ? lastFocus! : navBag).focus();
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const opener = t.closest<HTMLElement>('[data-open-order]');
    if (opener) {
      openOrder(opener);
      return;
    }
    const addBtn = t.closest<HTMLButtonElement>('[data-add]');
    if (addBtn) {
      const id = addBtn.dataset.add!;
      add(id);
      const prod = producto(id);
      if (prod) toast(`${prod.nombre} sumado al pedido`);
    }
  });

  lines.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-k]');
    if (b) change(b.dataset.k!, Number(b.dataset.d));
  });

  closeBtn.addEventListener('click', closeOrder);
  scrim.addEventListener('click', closeOrder);

  drawer.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      e.preventDefault();
      closeOrder();
      return;
    }
    if (e.key !== 'Tab') return;
    // Foco atrapado dentro del cajón
    const focusables = [
      ...drawer.querySelectorAll<HTMLElement>('button:not(:disabled), select, a[href], [tabindex="0"]'),
    ];
    if (!focusables.length) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const active = document.activeElement;
    if (e.shiftKey && (active === first || active === title)) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  });

  send.addEventListener('click', () => {
    if (!send.disabled) window.open(whatsappUrl(pickup.value), '_blank', 'noopener');
  });

  subscribe(render);
</script>
