---
import { Picture } from 'astro:assets';
import { foto } from '../lib/images';

const pasos = [
  {
    hora: '10:00', dia: 'Día 1', foto: 'panes-surtidos.jpg',
    titulo: 'Despertamos la masa madre',
    texto: 'La alimentamos con harina y agua, y cuando duplica su tamaño amasamos con harina de molino chico.',
  },
  {
    hora: '14:00', dia: 'Día 1', foto: 'centeno.jpg',
    titulo: 'Pliegues y formado a mano',
    texto: 'Cada media hora estiramos y plegamos la masa. Después la formamos una por una, sin máquinas.',
  },
  {
    hora: '18:00', dia: 'Día 1', foto: 'hogaza.jpg',
    titulo: 'Una noche en frío',
    texto: 'La fermentación lenta en la cámara le da sabor, una miga abierta y hace que dure toda la semana.',
  },
  {
    hora: '06:00', dia: 'Día 2', foto: 'hero.jpg',
    titulo: 'Horno de piso a 250 °C',
    texto: 'Cuarenta minutos de horno con vapor. A las 7 la hogaza está en la vidriera, todavía crujiendo.',
  },
];
---

<section class="process" id="proceso" aria-labelledby="proceso-title" data-process>
  <div class="wrap intro">
    <p class="mono kicker">Cómo lo hacemos</p>
    <h2 id="proceso-title">Veinte horas<br /> para <em>un pan.</em></h2>
  </div>

  <div class="wrap grid">
    <div class="stage">
      <div class="clock" aria-live="polite" aria-atomic="true">
        <span data-clock>{pasos[0].hora}</span>
        <small data-day>{pasos[0].dia.toUpperCase()}</small>
      </div>
      <div class="frames" aria-hidden="true">
        {
          pasos.map((p, i) => (
            <div class:list={['frame', { 'is-on': i === 0 }]} data-frame>
              <Picture
                src={foto(p.foto)}
                formats={['avif', 'webp']}
                widths={[480, 720, 1000]}
                sizes="(min-width: 861px) min(600px, 45vw), 1px"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>
          ))
        }
      </div>
    </div>

    <ol class="steps" role="list" data-steps>
      {
        pasos.map((p, i) => (
          <li class:list={['step', { 'is-on': i === 0 }]} data-time={p.hora} data-day={p.dia.toUpperCase()}>
            <span class="mono">Paso {i + 1} · {p.hora} · {p.dia}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    position: relative;
    background: var(--ink);
    color: var(--paper);
    padding-bottom: var(--section-pad);
  }

  .intro { padding-top: var(--section-pad); }
  .intro .mono { color: var(--yolk); }
  h2 { font-size: var(--fs-h2); }
  h2 em { font-style: italic; color: var(--yolk); }

  .grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }

  .stage {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    height: calc(100svh - 140px);
    min-height: 460px;
  }

  .clock {
    font-family: var(--mono);
    font-size: clamp(72px, 10vw, 150px);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -.04em;
    color: var(--yolk);
  }
  .clock small {
    display: block;
    margin-top: 10px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .12em;
    color: var(--on-ink-soft);
  }

  .frames {
    position: relative;
    flex: 1;
    max-height: 420px;
    overflow: hidden;
    border-radius: var(--r-photo);
    background: #3A2A20;
  }
  .frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.08);
    transition: opacity .7s ease, transform 1.2s var(--ease);
  }
  .frame.is-on { opacity: 1; transform: none; }
  .frame :global(picture) { display: block; height: 100%; }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .steps { padding-block: 18svh; }
  .step {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    min-height: 56svh;
  }
  .step .mono { color: var(--yolk); }
  .step h3 { font-size: clamp(40px, 4.6vw, 68px); }
  .step p { max-width: 42ch; font-size: 18px; color: var(--on-ink-soft); }

  /* Con JS, los pasos fuera de foco se apagan (sin bajar de 4.5:1) */
  .step .mono, .step h3, .step p { transition: color .5s; }
  .steps.is-live .step:not(.is-on) :is(.mono, h3, p) { color: var(--on-ink-dim); }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; gap: 0; }
    .stage {
      top: calc(var(--nav-h) + env(safe-area-inset-top, 0px));
      z-index: 2;
      flex-direction: row;
      align-items: center;
      height: auto;
      min-height: 0;
      padding-block: 12px;
      margin-inline: calc(-1 * var(--gutter-l)) calc(-1 * var(--gutter-r));
      padding-inline: var(--gutter-l) var(--gutter-r);
      background: var(--ink);
      box-shadow: 0 1px 0 rgba(243, 239, 231, .08);
    }
    .clock { display: flex; align-items: baseline; gap: 14px; font-size: 56px; }
    .clock small { margin-top: 0; }
    .frames { display: none; }
    .steps { padding-block: 4svh 10svh; }
    .step { min-height: 46svh; }
  }
</style>
