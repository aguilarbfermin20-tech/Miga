---
import { Picture } from 'astro:assets';
import type { Producto } from '../lib/types';
import { foto } from '../lib/images';
import { money } from '../lib/format';

interface Props {
  producto: Producto;
}

const { producto: p } = Astro.props;
---

<article class:list={['card', { hot: p.recienSalido, out: p.agotado }]} data-card>
  <div class="ph">
    <span class="when"><i aria-hidden="true"></i>{p.etiqueta}</span>
    <Picture
      src={foto(p.foto)}
      formats={['avif', 'webp']}
      widths={[300, 450, 600, 900]}
      quality={40}
      sizes="(max-width: 820px) 78vw, 360px"
      alt={p.alt}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="row">
    <h3>{p.nombre}</h3>
    <span class="price">{money(p.precio)}</span>
  </div>
  <p class="desc">{p.descripcion}</p>
  <button class="add" type="button" data-add={p.id}>
    <span data-add-label>+ Sumar al pedido</span><span class="visually-hidden">: {p.nombre}</span>
  </button>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ph {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--r-card);
    background: #8A5428;
    transition: box-shadow .3s;
  }
  .ph :global(picture) { display: block; height: 100%; }
  .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (hover: hover) {
    .card:hover .ph { box-shadow: var(--shadow-card); }
  }

  .when {
    position: absolute;
    z-index: 2;
    top: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: rgba(243, 239, 231, .92);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .when i {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--olive);
  }
  .hot .when i {
    background: var(--hot);
    animation: pulse 1.8s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(224, 112, 43, .6); }
    70% { box-shadow: 0 0 0 10px rgba(224, 112, 43, 0); }
    100% { box-shadow: 0 0 0 0 rgba(224, 112, 43, 0); }
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-top: 4px;
  }
  h3 {
    font-size: var(--fs-h3);
    line-height: 1;
  }
  .price {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
  }
  .desc { color: var(--muted); font-size: 15px; line-height: 1.5; }

  .add {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: auto;
    padding: 0 18px;
    border: 1.5px solid var(--ink);
    border-radius: var(--r-pill);
    background: transparent;
    font-weight: 600;
    font-size: 15px;
    transition: background-color .2s, color .2s, border-color .2s;
  }
  .add:hover { background: var(--ink); color: var(--paper); }
  .add.is-added { border-color: var(--olive); background: var(--olive); color: #fff; }

  /* Agotado: la foto se apaga (55 %) pero el texto mantiene contraste AA */
  .out .ph :global(picture) { opacity: .55; }
  .out .add { border-style: dashed; }
</style>
