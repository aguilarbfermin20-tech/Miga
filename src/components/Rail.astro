---
import ProductCard from './ProductCard.astro';
import productos from '../data/productos.json';
import type { Producto } from '../lib/types';

const lista = productos as Producto[];
const total = String(lista.length).padStart(2, '0');
---

<section class="rail" id="hoy" aria-labelledby="hoy-title" data-rail>
  <div class="sticky">
    <div class="wrap head">
      <h2 id="hoy-title">Hoy en el <em>horno</em></h2>
      <p>Sumá lo que quieras a tu pedido y mandalo por WhatsApp. Te lo guardamos hasta las 20 h.</p>
    </div>
    <div class="track-x" data-track>
      {lista.map((p) => <ProductCard producto={p} />)}
    </div>
    <div class="wrap rail-count" aria-hidden="true">
      <span data-rail-num>01 / {total}</span>
      <span class="bar"><i data-rail-bar></i></span>
    </div>
  </div>
</section>

<style>
  .rail { position: relative; }

  .sticky {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: var(--section-pad) 40px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px 24px;
  }
  h2 { font-size: var(--fs-h2); }
  h2 em { font-style: italic; color: var(--olive); }
  .head p { max-width: 38ch; color: var(--muted); }

  /* Por defecto (celular o sin JS): carrusel con scroll-snap */
  .track-x {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter-l) var(--gutter-r);
    padding: 4px var(--gutter-r) 16px var(--gutter-l);
    scrollbar-width: thin;
  }
  .track-x > :global(.card) {
    flex: 0 0 clamp(260px, 26vw, 360px);
    scroll-snap-align: start;
  }

  .rail-count { display: none; }

  @media (max-width: 820px) {
    .track-x { gap: 16px; }
    .track-x > :global(.card) { flex-basis: 78%; }
  }
  @media (min-width: 561px) and (max-width: 820px) {
    .track-x > :global(.card) { flex-basis: 44%; }
  }

  /* Compu con JS: galería horizontal fija (docs/04-interacciones.md §2) */
  @media (min-width: 821px) {
    .rail.is-pinned { height: var(--rail-h, auto); }
    .is-pinned .sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      justify-content: center;
      overflow: hidden;
      padding-block: calc(var(--nav-h) + 32px) 32px;
    }
    .is-pinned .track-x {
      width: max-content;
      overflow: visible;
      scroll-snap-type: none;
      padding-block: 0;
      will-change: transform;
    }
    .is-pinned .track-x > :global(.card) {
      flex-basis: clamp(240px, min(26vw, (100vh - 470px) * .8), 360px);
    }
    .is-pinned .rail-count {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: var(--mono);
      font-size: 13px;
      color: var(--muted);
    }
    .bar {
      position: relative;
      width: 120px;
      height: 2px;
      overflow: hidden;
      background: var(--crumb);
    }
    .bar i {
      position: absolute;
      inset: 0;
      background: var(--ink);
      transform-origin: left;
      transform: scaleX(var(--rp, 0));
    }
  }
</style>

<script>
  import { clamp, onResize, onScroll } from '../lib/motion';

  const rail = document.querySelector<HTMLElement>('[data-rail]')!;
  const track = rail.querySelector<HTMLElement>('[data-track]')!;
  const num = rail.querySelector<HTMLElement>('[data-rail-num]')!;
  const bar = rail.querySelector<HTMLElement>('[data-rail-bar]')!;
  const cards = [...track.querySelectorAll<HTMLElement>('[data-card]')];
  const wide = matchMedia('(min-width: 821px)');
  const total = String(cards.length).padStart(2, '0');

  let pinned = false;
  let extra = 0; // cuánto se desplaza el track en horizontal
  let span = 1; // cuánto scroll vertical consume la sección fija

  function setup() {
    pinned = wide.matches;
    rail.classList.toggle('is-pinned', pinned);
    if (!pinned) {
      rail.style.removeProperty('--rail-h');
      track.style.transform = '';
      return;
    }
    extra = Math.max(track.offsetWidth - document.documentElement.clientWidth, 0);
    rail.style.setProperty('--rail-h', `${window.innerHeight + extra}px`);
    span = Math.max(window.innerHeight + extra - window.innerHeight, 1);
  }

  function progress() {
    return clamp(-rail.getBoundingClientRect().top / span, 0, 1);
  }

  setup();
  onResize(setup);
  wide.addEventListener('change', setup);

  onScroll(() => {
    if (!pinned) return;
    const pr = progress();
    track.style.transform = `translateX(${-pr * extra}px)`;
    bar.style.setProperty('--rp', String(pr));
    num.textContent = `${String(Math.round(pr * (cards.length - 1)) + 1).padStart(2, '0')} / ${total}`;
  });

  /* Teclado: si el foco cae en una tarjeta fuera de vista, llevamos el scroll hasta ella */
  track.addEventListener('focusin', (e) => {
    if (!pinned || !extra) return;
    const card = (e.target as HTMLElement).closest<HTMLElement>('[data-card]');
    if (!card) return;
    const r = card.getBoundingClientRect();
    if (r.left >= 0 && r.right <= window.innerWidth) return;
    const want = clamp((card.offsetLeft - window.innerWidth * 0.3) / extra, 0, 1);
    const top = rail.getBoundingClientRect().top + window.scrollY;
    window.scrollTo({ top: top + want * span, behavior: 'instant' });
  });
</script>
