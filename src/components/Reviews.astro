---
import resenas from '../data/resenas.json';
import type { Resena } from '../lib/types';

const lista = resenas as Resena[];
---

<section class="quotes defer-render" aria-labelledby="resenas-title" data-reviews>
  <div class="wrap">
    <h2 id="resenas-title" class="mono kicker">Lo que dicen en el barrio</h2>

    <div class="quote-box" data-quote-box aria-live="polite">
      {
        lista.map((r, i) => (
          <figure class:list={['quote', { 'is-hidden': i !== 0 }]} data-quote>
            <blockquote>
              <p>“{r.texto} <em>{r.destacado}</em>”</p>
            </blockquote>
            <figcaption>{r.autor}</figcaption>
          </figure>
        ))
      }
    </div>

    <div class="qnav" data-qnav hidden>
      <button type="button" aria-label="Reseña anterior" data-qprev>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
      </button>
      <button type="button" aria-label="Reseña siguiente" data-qnext>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </button>
      <span class="dots" aria-hidden="true">
        {lista.map((_, i) => <i class:list={{ 'is-on': i === 0 }} />)}
      </span>
    </div>
  </div>
</section>

<style>
  .quotes { padding-block: var(--section-pad); contain-intrinsic-size: auto 600px; }
  h2 { color: var(--olive); margin-bottom: 24px; letter-spacing: .08em; }

  /* Las citas se apilan en la misma celda: el bloque mide lo de la más larga
     y los controles no saltan al cambiar de reseña */
  .quote-box { display: grid; }
  .quote {
    grid-area: 1 / 1;
    transition: opacity .25s var(--ease), transform .25s var(--ease);
  }
  .quote.is-hidden { visibility: hidden; }
  .quote.is-out { opacity: 0; transform: translateY(10px); }

  .quote p {
    max-width: 20ch;
    font-family: var(--serif);
    font-size: clamp(36px, 5.4vw, 80px);
    font-weight: 350;
    font-variation-settings: var(--fvs);
    line-height: 1.02;
    text-wrap: balance;
  }
  .quote em { color: var(--olive); }
  figcaption { margin-top: 24px; color: var(--muted); }

  .qnav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
  }
  .qnav[hidden] { display: none; }
  .qnav button {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: transparent;
    transition: background-color .2s, color .2s;
  }
  .qnav button:hover { background: var(--ink); color: var(--paper); }
  .qnav svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dots { display: flex; gap: 6px; margin-left: 8px; }
  .dots i {
    width: 24px;
    height: 3px;
    border-radius: 2px;
    background: var(--crumb);
  }
  .dots i.is-on { background: var(--ink); }
</style>

<script>
  import { prefersReducedMotion } from '../lib/motion';

  const root = document.querySelector<HTMLElement>('[data-reviews]')!;
  const quotes = [...root.querySelectorAll<HTMLElement>('[data-quote]')];
  const dots = [...root.querySelectorAll<HTMLElement>('.dots i')];
  const nav = root.querySelector<HTMLElement>('[data-qnav]')!;
  let current = 0;
  let timer = 0;

  function reveal(next: number) {
    quotes.forEach((q, j) => {
      q.classList.toggle('is-hidden', j !== next);
      if (j !== next) q.classList.remove('is-out');
    });
  }

  function show(i: number) {
    current = (i + quotes.length) % quotes.length;
    const next = current;
    dots.forEach((d, j) => d.classList.toggle('is-on', j === next));
    clearTimeout(timer);

    if (prefersReducedMotion()) {
      reveal(next);
      return;
    }
    // Fundido de salida de la que está visible, y entrada con subida de 10 px
    quotes.forEach((q) => !q.classList.contains('is-hidden') && q.classList.add('is-out'));
    timer = window.setTimeout(() => {
      const q = quotes[next];
      q.classList.add('is-out');
      reveal(next);
      requestAnimationFrame(() => requestAnimationFrame(() => q.classList.remove('is-out')));
    }, 250);
  }

  if (quotes.length > 1) {
    nav.hidden = false;
    root.querySelector('[data-qprev]')!.addEventListener('click', () => show(current - 1));
    root.querySelector('[data-qnext]')!.addEventListener('click', () => show(current + 1));
  }
</script>
