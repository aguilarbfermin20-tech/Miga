---
import productos from '../data/productos.json';
import horarios from '../data/horarios.json';
import type { Producto } from '../lib/types';

const minutos = (h: string) => {
  const [hh, mm] = h.split(':').map(Number);
  return hh * 60 + mm;
};

const items = (productos as Producto[])
  .filter((p) => !p.agotado)
  .sort((a, b) => minutos(a.horario) - minutos(b.horario))
  .map((p) => `${p.horario} ${p.nombre.toLowerCase()}`);

items.push(`Encargos hasta las ${Number(horarios.encargosHasta.split(':')[0])} h`);
---

<!-- Banda fija con los horarios del día: se lee de un vistazo, sin texto en movimiento -->
<div class="ticker">
  <ul class="wrap" role="list" aria-label="Horarios de horneado de hoy">
    {items.map((t) => <li>{t}</li>)}
  </ul>
</div>

<style>
  .ticker {
    border-block: 1.5px solid var(--ink);
    background: var(--yolk);
    color: var(--ink);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 8px 24px;
    padding-block: 14px;
  }
  li {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .02em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  li::before { content: "✶"; margin-right: 8px; }

  /* En una sola línea, los horarios se reparten a lo ancho */
  @media (min-width: 1200px) {
    ul { justify-content: space-between; }
  }
  @media (max-width: 760px) {
    ul { gap: 6px 20px; }
  }
</style>
