---
import { Picture } from 'astro:assets';
import localImg from '../assets/img/local.jpg';
import horarios from '../data/horarios.json';
import type { Horarios } from '../lib/types';

const h = horarios as Horarios;
const hora = (s: string) => s.replace(/^0/, '');
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(h.direccion)}`;
const [calle, barrio] = h.direccion.split(', ');
---

<section class="local defer-render" id="local" aria-labelledby="local-title" data-visit>
  <div class="photo">
    <Picture
      src={localImg}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200]}
      quality={40}
      sizes="(max-width: 860px) 100vw, 55vw"
      alt="Mostrador de la panadería con panes y facturas del día"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="info">
    <p class="open" data-open hidden>
      <i aria-hidden="true"></i><span data-open-text></span>
    </p>
    <h2 id="local-title">{calle}, {barrio}</h2>

    <table class="hours">
      <caption class="visually-hidden">Horarios de atención</caption>
      <tbody>
        {
          h.dias.map((d) => (
            <tr data-dia={d.dia}>
              <th scope="row">
                {d.dia}<span class="today-mark" data-today-mark hidden> · hoy</span>
              </th>
              <td>{d.abre && d.cierra ? `${hora(d.abre)} a ${hora(d.cierra)}` : 'Cerrado'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p>
      WhatsApp para encargos: <strong>{h.whatsappVisible}</strong>. Tomamos pedidos hasta las
      {Number(h.encargosHasta.split(':')[0])} h para el día siguiente.
    </p>

    <div class="ctas">
      <button class="btn btn-ink" type="button" data-open-order aria-haspopup="dialog" aria-controls="pedido">
        Ver mi pedido
      </button>
      <a class="btn btn-line" href={mapsUrl} target="_blank" rel="noopener">
        Cómo llegar<span class="visually-hidden"> (se abre en una pestaña nueva)</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .local {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    background: var(--crumb);
  }

  .photo {
    position: relative;
    min-height: 560px;
    overflow: hidden;
  }
  .photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: var(--section-pad) var(--gutter-r) var(--section-pad) 56px;
  }

  h2 { font-size: clamp(48px, 6vw, 92px); }

  .open {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
  }
  .open[hidden] { display: none; }
  .open i {
    width: 10px;
    height: 10px;
    flex: none;
    border-radius: 50%;
    background: var(--wa);
    box-shadow: 0 0 0 4px rgba(31, 138, 76, .18);
  }
  .open.is-closed i {
    background: var(--closed);
    box-shadow: 0 0 0 4px rgba(180, 35, 24, .18);
  }

  .hours {
    width: 100%;
    max-width: 440px;
    border-collapse: collapse;
    font-family: var(--mono);
    font-size: 14px;
  }
  .hours th, .hours td {
    padding: 12px 0;
    border-bottom: 1px solid rgba(26, 21, 18, .14);
    font-weight: 500;
    text-align: left;
  }
  .hours td { text-align: right; }
  .hours tr.is-today :is(th, td) { font-weight: 700; }

  .ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .ctas svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 860px) {
    .local { grid-template-columns: 1fr; }
    .photo { min-height: 300px; }
    .info { padding: 48px var(--gutter-r) 56px var(--gutter-l); }
  }
</style>

<script>
  import horarios from '../data/horarios.json';
  import type { Horarios, NombreDia } from '../lib/types';

  const h = horarios as Horarios;
  const root = document.querySelector<HTMLElement>('[data-visit]')!;
  const status = root.querySelector<HTMLElement>('[data-open]')!;
  const statusText = root.querySelector<HTMLElement>('[data-open-text]')!;

  // Hora local del local (Buenos Aires), no la del navegador: si alguien abre la página
  // desde otro huso, igual ve si la panadería está abierta en este momento.
  const ZONA = 'America/Argentina/Buenos_Aires';
  const DIAS: NombreDia[] = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
  const aMin = (s: string) => {
    const [hh, mm] = s.split(':').map(Number);
    return hh * 60 + mm;
  };

  function update() {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: ZONA,
      weekday: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
    }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
    const idx = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday'));
    const ahora = Number(get('hour')) * 60 + Number(get('minute'));
    const nombre = DIAS[idx];
    const hoy = h.dias.find((d) => d.dia === nombre);

    root.querySelectorAll<HTMLElement>('tr[data-dia]').forEach((tr) => {
      const esHoy = tr.dataset.dia === nombre;
      tr.classList.toggle('is-today', esHoy);
      tr.querySelector<HTMLElement>('[data-today-mark]')!.hidden = !esHoy;
    });

    const abierto = !!hoy?.abre && !!hoy.cierra && ahora >= aMin(hoy.abre) && ahora < aMin(hoy.cierra);
    status.classList.toggle('is-closed', !abierto);
    statusText.textContent = abierto
      ? `Abierto ahora · cierra a las ${hoy!.cierra}`
      : 'Cerrado ahora · tomamos encargos por WhatsApp';
    status.hidden = false;
  }

  update();
  window.setInterval(update, 60_000);
</script>
