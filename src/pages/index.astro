---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import Rail from '../components/Rail.astro';
import Process from '../components/Process.astro';
import Reviews from '../components/Reviews.astro';
import Visit from '../components/Visit.astro';
import Footer from '../components/Footer.astro';
import OrderDrawer from '../components/OrderDrawer.astro';
---

<Base
  title="Miga · Panadería de masa madre en Villa Crespo"
  description="Pan de masa madre horneado todos los días en Villa Crespo. Armá tu pedido y mandalo por WhatsApp."
>
  <Nav />
  <Hero />
  <Ticker />
  <main id="contenido" tabindex="-1">
    <Rail />
    <Process />
    <Reviews />
    <Visit />
  </main>
  <Footer />
  <OrderDrawer />
</Base>
